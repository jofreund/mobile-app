    "settings_about_description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Music Assistant is a free, open-source, self-hosted music server. Connect to your server below to browse your library and control playback throughout your home."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Music Assistant ist ein kostenloser und selbst gehosteter open-source Musik Server. Verbinde Dich mit Deinem Server, um Deine Bibliothek zu durchsuchen und die Wiedergabe aller Player im Haus zu steuern."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Music Assistant is een gratis, open-source, zelfgehoste muziekserver. Maak hieronder verbinding met jouw server om door je bibliotheek te bladeren en de weergave in je hele huis te bedienen."
          }
        }
      }
    },
