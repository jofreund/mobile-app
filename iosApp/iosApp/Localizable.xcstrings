            "value" : "取消"
          }
        }
      }
    },
    "schema_incompatible_dialog_exit" : {
      "comment" : "Exit button on the terminal schema-incompatible dialog. Mirrors Compose resource schema_incompatible_dialog_exit.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beenden"
          }
        },
        "en" : {
