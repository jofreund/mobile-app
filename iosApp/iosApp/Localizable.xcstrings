{
  "sourceLanguage" : "en",
  "strings" : {
    "banner_no_network" : {
      "comment" : "AppShellRootView reconnection banner — shown when Reconnecting and offline. Mirrors Compose resource banner_no_network (values/strings.xml) so both stay in sync until the Phase D localization migration adopts this catalog as the source of truth.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Netzwerk verfügbar"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No network available"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen netwerk beschikbaar"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无可用网络"
          }
        }
      }
    },
    "banner_reconnecting" : {
      "comment" : "AppShellRootView reconnection banner — %1$d is the retry attempt number. Mirrors Compose resource banner_reconnecting.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederverbinden... (Versuch %1$d)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconnecting… (attempt %1$d)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opnieuw verbinden… (poging %1$d)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在重新连接…（尝试 %1$d）"
          }
        }
      }
    },
    "common_cancel" : {
      "comment" : "Cancel button, used by both the auto-login splash and the reconnection banner. Mirrors Compose resource common_cancel.",
