{
  "sourceLanguage" : "en",
  "strings" : {
    "banner_no_network" : {
      "comment" : "AppShellRootView reconnection banner — shown when Reconnecting and offline. Mirrors Compose resource banner_no_network (values/strings.xml) so both stay in sync until the Phase D localization migration adopts this catalog as the source of truth.",
