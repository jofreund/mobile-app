            "value" : "OK"
          }
        }
      }
    },
    "schema_version_dialog_message" : {
      "comment" : "Mirrors Compose resource schema_version_dialog_message.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server nutzt ein neueres Datenformat als diese App. Manche Funktionen sind möglicherweise eingeschränkt. Bitte aktualisiere die App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This server uses newer data format version than this app. Some features may not work correctly. Consider updating the app."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze server maakt gebruik van een nieuwere versie van het gegevensformaat dan deze app. Sommige functies werken mogelijk niet correct. Overweeg om de app bij te werken."
          }
        }
      }
    },
    "schema_version_dialog_title" : {
      "comment" : "Mirrors Compose resource schema_version_dialog_title.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
