    "settings_webrtc_disclaimer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WebRTC connection can be slower and less reliable than direct or proxied connection to your server."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WebRTC Verbindungen können langsamer und weniger zuverlässig als direkte oder proxybasierte Verbindungen sein."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De WebRTC-verbinding kan trager en minder betrouwbaar zijn dan een directe verbinding of een verbinding via een proxy met je server."
          }
        }
      }
    },
    "settings_webrtc_info": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WebRTC uses cloud signalling with end-to-end encryption. Works through most firewalls and NATs."
