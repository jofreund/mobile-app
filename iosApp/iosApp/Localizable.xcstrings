          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afsluiten"
          }
        }
      }
    },
    "schema_incompatible_dialog_message" : {
      "comment" : "Mirrors Compose resource schema_incompatible_dialog_message.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App-Version ist zu alt für diesen Server. Bitte aktualisiere die App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app is too old to connect to this server. Please update the app to continue."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze app is te oud om verbinding te maken met deze server. Werk de app bij om door te gaan."
          }
        }
      }
    },
    "schema_incompatible_dialog_title" : {
      "comment" : "Mirrors Compose resource schema_incompatible_dialog_title.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update erforderlich"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update required"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update vereist"
          }
        }
      }
    },
    "schema_version_dialog_confirm" : {
      "comment" : "Mirrors Compose resource schema_version_dialog_confirm.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
