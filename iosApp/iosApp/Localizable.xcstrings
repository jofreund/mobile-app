    "background_usage_dialog_message" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App kann nicht im Hintergrund ausgeführt werden. Deshalb endet die lokale Wiedergabe kurz nach dem Verlassen. Öffne \"Einstellungen\", dann \"Akku“ und erlaube die Hintergrundnutzung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Background usage is disabled for this app, so local playback stops shortly after you leave. Tap Open settings, then Battery, and allow background usage to keep playing."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achtergrondgebruik voor deze app is uitgeschakeld, waardoor lokaal afspelen kort na het verlaten van de app stopt. Tik op Instellingen openen, vervolgens op Batterij en schakel achtergrondgebruik in om door te kunnen gaan met afspelen."
          }
        }
      }
    },
