<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared with the app target so the widget process can read the downscaled artwork the
	     app writes for the Live Activity — see PlayerActivityArtworkStore. Keep the id in sync
	     with PlayerActivityShared.swift. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.jofreund.taktgeber</string>
	</array>
</dict>
</plist>
