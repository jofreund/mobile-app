TEAM_ID=5J5R9QK64D
// The app target used to override this, which made the line here dead and misleading — the
// shipping id was com.jofreund.music-assistant-client, set in the pbxproj. The override is gone,
// so this is the one place the bundle id lives again, as the build docs already claimed.
PRODUCT_BUNDLE_IDENTIFIER=com.jofreund.taktgeber
APP_NAME=Taktgeber
IPHONEOS_DEPLOYMENT_TARGET = 26.0

// Intel-simulator slice was removed from the KMP build (iosX64 dropped after CMP 1.11.0).
// Without this exclusion, xcodebuild on CI builds a universal simulator slice and the
// :composeApp:syncComposeResourcesForIos task fails with "Unknown iOS simulator arch: 'x86_64'".
EXCLUDED_ARCHS[sdk=iphonesimulator*] = x86_64
